# =============================================================================
# fq-compressor .gitignore
# =============================================================================

# 忽略所有的对象文件和库文件
*.o
*.a
*.so
*.dll
*.dylib
*.lib

# 忽略所有的编译输出目录
/cmake-build-debug/
/cmake-build-*/
/build/
/bin/
/obj/
/out/

# CTest 生成文件
/Testing/

# 忽略所有的临时文件
*.tmp
*.log
*.swp
*.bak

# 忽略所有的 IDE 配置文件
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# 忽略所有的 CMake 生成文件
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
Makefile

# 忽略所有的自动生成的文档
docs/generated/
docs/api/

# 忽略所有的覆盖率报告
coverage/
*.gcda
*.gcno
*.gcov

# 忽略 Conan 生成文件（conan.lock 例外：lockfile 是依赖可复现性契约，随仓库提交）
conaninfo.txt
conanbuildinfo.*
conan_toolchain.cmake

# 忽略 vcpkg 安装目录
vcpkg_installed/

# 用户特定的 CMake 预设
CMakeUserPresets.json

# OS 特定文件
.DS_Store
Thumbs.db

# 编辑器/LSP 缓存
.clangd/

# 通用构建与安装输出
build*/
install/
install-*/

# 工具与分析报告
clang-tidy-fixes.yml
*.sarif
benchmark-*.json
benchmark-*.csv

# 本地性能基线归档：入库（见 perf-baselines/README.md 与 docs/benchmarks.md）。
# 单次运行产生的临时工作文件不落盘在仓库内（test_performance.sh 用 mktemp），
# 因此整个目录可直接跟踪；如需排除超大临时产物再单独加规则。
# perf-baselines/

# 真实语料切片（见 docs/real-corpus.md / scripts/fetch_real_corpus.sh）
corpus/

# 覆盖率与分析数据
*.profraw
*.profdata

# Benchmark datasets (local caches and prepared subsets)
# benchmark_v2/ 已随项目瘦身删除（见 CHANGELOG 0.2.0），此规则为残留，删除。

# Python 相关
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env

# Honkit / GitBook
node_modules/
_book/
docs/.site/
.honkit/
.cache/

# 压缩测试数据
*.fqc
*.fqc.idx

# 冻结格式 fixture 是 decoder 兼容契约，必须入库
!tests/fixtures/**/*.fqc

# OpenSpec - AI tool directories (configure per-project as needed)
# Most projects should track OpenSpec skills/commands for consistency
# Uncomment to ignore all AI tool configs:
.agent/
.amazonq/
.augment/
.bob/
.claude/
.cline/
.clinerules/
.codebuddy/
.codex/
.continue/
.cospec/
.crush/
.cursor/
.factory/
.forge/
.gemini/
.iflow/
.junie/
.kilocode/
.kiro/
.lingma/
.omc/
.opencode/
.pi/
.qoder/
.qwen/
.roo/
.trae/
.windsurf/

# OpenSpec explorations (scratch/research docs, not tracked)
openspec/explorations/

# Local git worktrees
.worktrees
.worktrees/

# Reference projects (source code not tracked, but keep README)
ref-projects/*
!ref-projects/README.md

# Superpowers 规划文档（本地开发规划，不提交）
docs/superpowers/plans/

# scripts/notes.sh board 生成的本地看板
/board.html
